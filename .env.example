# ---------------------------------------------------------------------------
# Google AI Studio
# ---------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and OAuth callbacks.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Email OTP login (Gmail SMTP)
# ---------------------------------------------------------------------------
# Use a Google Account with 2-Step Verification turned on, then create an
# App Password at https://myaccount.google.com/apppasswords
# A normal Google account password will NOT work here.
# Gmail caps a single sender at roughly 500 messages per day.
SMTP_USER="youraccount@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# Set to true only for implicit TLS (port 465). Port 587 uses STARTTLS.
SMTP_SECURE="false"
SMTP_FROM="Manchitra <youraccount@gmail.com>"

# ---------------------------------------------------------------------------
# Google Sign-In (optional)
# ---------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add your origin to "Authorised JavaScript origins".
# Must match VITE_GOOGLE_CLIENT_ID exactly or token verification fails.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Session security
# ---------------------------------------------------------------------------
# Long random string. Changing it invalidates every pending OTP code.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
OTP_PEPPER=""

# Comma separated list of frontend origins allowed to send credentialed
# requests. Leave empty when the API and frontend share one origin.
# Example: https://yourusername.github.io
CORS_ORIGINS=""

# Secret for POST /api/places/bulk. The endpoint fails closed when unset.
ADMIN_SYNC_TOKEN=""

# ---------------------------------------------------------------------------
# Frontend build-time variables (Vite inlines these into the bundle)
# ---------------------------------------------------------------------------
# Leave empty when the frontend and API share one origin.
#
# NOTE: do NOT point this at https://<user>.github.io/<repo>/. GitHub Pages only
# serves static files, so there is no /api/auth or /api/places behind it and
# every request would return 404. Set this to the origin of the Express server,
# for example https://manchitra-api.onrender.com
VITE_API_BASE=""
# Must match GOOGLE_CLIENT_ID above.
VITE_GOOGLE_CLIENT_ID=""
# Stable "latest APK" download link. The release workflow sets this automatically;
# set it manually only when building outside CI.
VITE_APK_URL=""